<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>None</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="SimplePdfReader.app.ico" />
    <EmbeddedResource Include="logo.png" LogicalName="SimplePdfReader.logo.png" />

    <!-- The viewer and PDF.js are embedded so the published app is a single EXE. -->
    <EmbeddedResource Include="viewer.html" LogicalName="SimplePdfReader.web.viewer.html" />
    <EmbeddedResource Include="style.css" LogicalName="SimplePdfReader.web.style.css" Condition="Exists('style.css')" />
    <EmbeddedResource Include="web\pdfjs\pdf.min.js" LogicalName="SimplePdfReader.web.pdfjs.pdf.min.js" />
    <EmbeddedResource Include="web\pdfjs\pdf.worker.min.js" LogicalName="SimplePdfReader.web.pdfjs.pdf.worker.min.js" />
    <EmbeddedResource Include="web\pdfjs\LICENSE" LogicalName="SimplePdfReader.web.pdfjs.LICENSE" />
    <EmbeddedResource Include="web\pdfjs\standard_fonts\LICENSE_FOXIT" LogicalName="SimplePdfReader.web.pdfjs.standard_fonts.LICENSE_FOXIT" />
    <EmbeddedResource Include="web\pdfjs\standard_fonts\LICENSE_LIBERATION" LogicalName="SimplePdfReader.web.pdfjs.standard_fonts.LICENSE_LIBERATION" />
    <EmbeddedResource Include="web\pdfjs\cmaps\*.bcmap" LogicalName="SimplePdfReader.web.pdfjs.cmaps.%(Filename)%(Extension)" />
    <EmbeddedResource Include="web\pdfjs\standard_fonts\*.pfb" LogicalName="SimplePdfReader.web.pdfjs.standard_fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="web\pdfjs\standard_fonts\*.ttf" LogicalName="SimplePdfReader.web.pdfjs.standard_fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Keep only the single EXE in the publish output. -->
  <Target Name="RemoveDocumentationFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
